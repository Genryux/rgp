# Supabase Configuration (Frontend Client)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Cloudflare Turnstile Site Key for contact form protection
VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...

# ==============================================================================
# Supabase Edge Function Secrets (Set in Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets)
# Do NOT put these in frontend .env files!
# ==============================================================================
# GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
#
# NOTE: GMAIL_REFRESH_TOKEN and STUDIO_EMAIL are NO LONGER required as manual secrets!
# The studio owner simply clicks "Connect with Google" in the Admin Settings tab,
# and their tokens/email are automatically stored securely in the database.

